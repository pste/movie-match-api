{
  "name": "movie-match-api",
  "version": "1.0.0",
  "description": "REST API for movie-match",
  "main": "app.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env app.js",
    "prod": "node app.js",
    "test": "LOG_LEVEL=silent node --env-file-if-exists=.env --test --test-concurrency=1",
    "backfill-genres": "node --env-file-if-exists=.env app.js backfill-genres"
  },
  "author": "pste",
  "license": "MIT",
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
